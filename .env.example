# Copy to .env and uncomment any settings you want to override.
# Defaults live in pka/config.py — these examples mirror them.
#
# Credentials (API keys, passwords, tokens) do NOT belong here. Put them in a
# .secrets file next to .env, same KEY=value format but with each key prefixed
# by SECRET_ — see .secrets.example. A .secrets value overrides .env; a real
# environment variable still wins over both. Override the file location with
# ALEXANDRIA_SECRETS_FILE, or set it empty to disable the secrets file.

# ── Source paths ──────────────────────────────────────────────────────────────
# ALEXANDRIA_ZOTERO_DB=~/Zotero/zotero.sqlite
# ALEXANDRIA_FIREFOX_DB=~/.mozilla/firefox
# ALEXANDRIA_BOOK_ARCHIVE=~/Documents/books
# One or more image folders, as a JSON array (managed from the Ingestion UI):
# ALEXANDRIA_IMAGE_DIRS=["~/Pictures/research","~/Pictures/screenshots"]
# The legacy singular form is still honoured as a fallback:
# ALEXANDRIA_IMAGES_DIR=~/Pictures/research

# ── YouTube (Data API v3 — a network source; opt-in, read-only) ───────────────
# Needs the optional extra:  pip install -e '.[youtube]'
# Point this at a *desktop app* OAuth client secret JSON from Google Cloud
# Console. The connector is inert until this file (or a cached token) exists;
# the refresh token is cached at data/youtube_token.json (git-ignored).
# ALEXANDRIA_YOUTUBE_CLIENT_SECRET=~/.config/alexandria/youtube_client_secret.json

# ── Output paths ──────────────────────────────────────────────────────────────
# ALEXANDRIA_DATA_DIR=data

# ── Model providers (per-capability; text chunks always embed via Chroma) ─────
# Each capability picks its own backend independently, so you can e.g. run
# remote chat/vision while keeping OCR + image embeddings local.
# ALEXANDRIA_CHAT_PROVIDER=ollama         # ollama | ollama_cloud | openrouter | ovh | scaleway
# ALEXANDRIA_VISION_PROVIDER=ollama       # ollama | ollama_cloud | openrouter | ovh | scaleway
# ALEXANDRIA_OCR_PROVIDER=vlm             # vlm (vision model transcribes) | easyocr
# ALEXANDRIA_OCR_ENABLED=1                # set 0 to skip text extraction entirely
# ALEXANDRIA_IMAGE_EMBED_PROVIDER=clip    # clip
# ALEXANDRIA_CLIP_ENABLED=0              # set 1 to index+search visual (CLIP) vectors;
#                                        # off, images are still found by their inferred text

# ── Image admission gate (text coverage + VLM category) ───────────────────────
# Filter incoming images before the expensive passes: keep only those that are
# >N% text (measured by EasyOCR) AND classified into a category of interest by a
# fast VLM. Failures are cached in the image_rejections table and skipped later.
# ALEXANDRIA_IMAGE_GATE_ENABLED=1                 # set 0 to ingest every image
# ALEXANDRIA_IMAGE_GATE_TEXT_COVERAGE_MIN=0.05    # min fraction of pixels that are text
# ALEXANDRIA_IMAGE_GATE_VISION_PROVIDER=ollama    # ollama | ollama_cloud | openrouter | ovh | scaleway
# ALEXANDRIA_IMAGE_GATE_VISION_MODEL=moondream    # small/fast; its label also picks the per-type prompt

# ── Ollama (local chat / vision) ──────────────────────────────────────────────
# ALEXANDRIA_OLLAMA_BASE_URL=http://localhost:11434
# ALEXANDRIA_CHAT_MODEL=            # empty (the default) ⇒ auto-detect: the first
#                                   # non-embedding model the daemon lists, else llama3
# ALEXANDRIA_VISION_MODEL=llava        # default (classify + describe + VLM OCR); "llava-phi3" is lighter
# ALEXANDRIA_VLM_OCR_MODEL=            # override just the OCR model; empty ⇒ reuse VISION_MODEL
#
# Route A — cloud models through the *local* daemon. Run `ollama signin` once,
# `ollama pull gpt-oss:120b-cloud`, then just name the ":cloud"-tagged model
# above; provider stays "ollama" and nothing else here changes.

# ── Ollama Cloud, Route B — direct to ollama.com (*_PROVIDER=ollama_cloud) ────
# Same native Ollama API, no local daemon involved. Create a key at
# https://ollama.com/settings/keys; it belongs with the other credentials, as
# SECRET_ALEXANDRIA_OLLAMA_CLOUD_API_KEY.
# Cloud model tags carry no "-cloud" suffix on this route.
# ALEXANDRIA_OLLAMA_CLOUD_BASE_URL=https://ollama.com
# ALEXANDRIA_OLLAMA_CLOUD_CHAT_MODEL=gpt-oss:120b
# ALEXANDRIA_OLLAMA_CLOUD_VISION_MODEL=      # must be vision-capable, e.g. qwen3.5:397b

# ── OpenRouter (set *_PROVIDER=openrouter above to use) ───────────────────────
# API key belongs in .secrets as SECRET_ALEXANDRIA_OPENROUTER_API_KEY
# ALEXANDRIA_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# ALEXANDRIA_OPENROUTER_CHAT_MODEL=openai/gpt-4o-mini
# ALEXANDRIA_OPENROUTER_VISION_MODEL=openai/gpt-4o-mini

# ── OVH AI Endpoints (set *_PROVIDER=ovh above to use) ────────────────────────
# API key belongs in .secrets as SECRET_ALEXANDRIA_OVH_API_KEY
# ALEXANDRIA_OVH_BASE_URL=https://<model>.endpoints.<region>.ai.cloud.ovh.net/api/openai_compat/v1
# ALEXANDRIA_OVH_CHAT_MODEL=Meta-Llama-3_1-70B-Instruct
# ALEXANDRIA_OVH_VISION_MODEL=

# ── Scaleway Generative APIs (set *_PROVIDER=scaleway above to use) ───────────
# API key belongs in .secrets as SECRET_ALEXANDRIA_SCALEWAY_API_KEY
# ALEXANDRIA_SCALEWAY_BASE_URL=https://api.scaleway.ai/v1
# ALEXANDRIA_SCALEWAY_CHAT_MODEL=llama-3.3-70b-instruct
# ALEXANDRIA_SCALEWAY_VISION_MODEL=

# ── Chunking ──────────────────────────────────────────────────────────────────
# ALEXANDRIA_CHUNK_SENTENCES=5
# ALEXANDRIA_CHUNK_OVERLAP=1
# ALEXANDRIA_MIN_CHUNK_CHARS=80

# ── Firefox fetch ─────────────────────────────────────────────────────────────
# ALEXANDRIA_FETCH_TIMEOUT_SECONDS=10
# ALEXANDRIA_FETCH_CONNECT_TIMEOUT_SECONDS=5
# ALEXANDRIA_FETCH_CONCURRENCY=8
# ALEXANDRIA_FETCH_WAYBACK_FALLBACK=1   # on HTTP 404, send URL to archive.org for a snapshot
# ALEXANDRIA_FETCH_WAYBACK_EXTRA_BUDGET_SECONDS=15
# ALEXANDRIA_FETCH_WIKIPEDIA_RETRY_DELAY_SECONDS=2
# ALEXANDRIA_FETCH_WIKIPEDIA_MAX_RETRIES=2
# ALEXANDRIA_FETCH_USER_AGENT=Alexandria/0.2 (local research library)

# ── Reddit saved posts ───────────────────────────────────────────────────────
# Needs no app registration: the private saved-links feed from
# https://www.reddit.com/prefs/feeds/ (RSS or JSON URL, both accepted — the
# loader always fetches the RSS/Atom form, the only one Reddit serves to
# non-browser clients). This is the connector's only credential; the OAuth API
# route was removed. The URL contains a token that reads your saved list —
# treat it as a password, hence .secrets.
# SECRET_ALEXANDRIA_REDDIT_FEED_URL=
# ALEXANDRIA_REDDIT_USER_AGENT=Alexandria/0.2 (local research library; saved-post indexer)
# ALEXANDRIA_REDDIT_SAVED_LIMIT=         # blank = all saved items
# Every poll is written to data/reddit/<timestamp>/ (raw Atom pages + manifest)
# and merged, deduplicated, into data/reddit/saved.jsonl. On by default: a local
# write, and the feed serves only the newest slice, so an unarchived poll is
# gone for good once the token stops working. `alexandria reddit --from-archive`
# re-ingests from that log without touching the network.
# ALEXANDRIA_REDDIT_ARCHIVE_ENABLED=1

# ── Images ────────────────────────────────────────────────────────────────────
# ALEXANDRIA_OCR_LANG=eng
# ALEXANDRIA_CLIP_MODEL=openai/clip-vit-base-patch32

# ── Retrieval enrichment (DESIGN.md §3.2) ─────────────────────────────────────
# What each document type contributes to the vector index. The per-type VLM
# prompts (transcript for slides/notes/whiteboards, content summary for posters,
# structured extraction for book covers) are always on and purely local — they
# need no setting here. Everything below is off by default.
#
# Local LLM summary chunk for Firefox bookmarks and Reddit posts. Uses
# chat_provider, so cost scales with your largest source — enable deliberately.
# ALEXANDRIA_BOOKMARK_SUMMARY_ENABLED=0
#
# Same, for Calibre full text. Separate flag on purpose: a book is map-reduced
# over its whole text (many calls) where a bookmark is usually one, so turning on
# the cheap case must not turn on the expensive one.
# ALEXANDRIA_BOOK_SUMMARY_ENABLED=0
#
# Identifier lookups (Open Library) for book covers and Calibre books. Sends an
# ISBN or a title+author string — i.e. library inventory, not document content.
# ALEXANDRIA_EXTERNAL_LOOKUP_ENABLED=0
#
# Second-catalogue fallback for covers Open Library does not know. Requires
# ALEXANDRIA_EXTERNAL_LOOKUP_ENABLED=1; has no effect on its own.
# ALEXANDRIA_COVER_SEARCH_FALLBACK=0
#
# Backend(s) for that fallback — comma-separated, tried in order, first verified
# hit wins. See the registry in pka/ingestion/book_search.py.
#   google_books : catalogue. No key or signup needed; a key only raises quota.
#   brave        : web search. Needs a key; yields a search snippet rather than a
#                  curated synopsis, and verifies more loosely — put it last.
#   staan        : web search (Qwant-backed). Needs a key; same loose snippet
#                  verification as brave — put it last too.
# ALEXANDRIA_SEARCH_PROVIDER=google_books
# ALEXANDRIA_SEARCH_PROVIDER=google_books,brave   # catalogue first, web after
# One key per backend — they are separate vendors, so a key set for one is never
# sent to the other. Brave/Staan need their key or the rung skips; Google Books
# runs fine without one and only gains quota from it.
# SECRET_ALEXANDRIA_SEARCH_API_KEY=          # brave
# SECRET_ALEXANDRIA_GOOGLE_BOOKS_API_KEY=    # optional
# SECRET_ALEXANDRIA_STAAN_API_KEY=           # staan

# ── API ───────────────────────────────────────────────────────────────────────
# ALEXANDRIA_DEV=1   # dev API: CORS for :5173 + one-time Firefox/Zotero DB snapshots
#              # also re-queues all unfetchable Firefox URLs on Fetch & embed
# Per-source doc cap during dev ingestion (default 10 each):
# ALEXANDRIA_DEV_INGESTION_LIMIT_FIREFOX=10
# ALEXANDRIA_DEV_INGESTION_LIMIT_ZOTERO=10
# ALEXANDRIA_DEV_INGESTION_LIMIT_CALIBRE=10
# ALEXANDRIA_DEV_INGESTION_LIMIT_IMAGE=10
# ALEXANDRIA_DEV_INGESTION_LIMIT_YOUTUBE=10
# ALEXANDRIA_DEV_INGESTION_LIMIT_REDDIT=10
