# Copy to .env and uncomment any settings you want to override.
# Defaults live in pka/config.py — these examples mirror them.

# ── Source paths ──────────────────────────────────────────────────────────────
# ALEXANDRIA_ZOTERO_DB=~/Zotero/zotero.sqlite
# ALEXANDRIA_FIREFOX_DB=~/.mozilla/firefox
# ALEXANDRIA_BOOK_ARCHIVE=~/Documents/books
# One or more image folders, as a JSON array (managed from the Ingestion UI):
# ALEXANDRIA_IMAGE_DIRS=["~/Pictures/research","~/Pictures/screenshots"]
# The legacy singular form is still honoured as a fallback:
# ALEXANDRIA_IMAGES_DIR=~/Pictures/research

# ── Output paths ──────────────────────────────────────────────────────────────
# ALEXANDRIA_DATA_DIR=data

# ── Ollama (chat / vision only; text chunks embed via Chroma) ─────────────────
# ALEXANDRIA_OLLAMA_BASE_URL=http://localhost:11434
# ALEXANDRIA_CHAT_MODEL=minimax-m2.5:cloud
# ALEXANDRIA_VISION_MODEL=llava-phi3   # default; "llava" is slower but a bit more accurate

# ── Chunking ──────────────────────────────────────────────────────────────────
# ALEXANDRIA_CHUNK_SENTENCES=5
# ALEXANDRIA_CHUNK_OVERLAP=1
# ALEXANDRIA_MIN_CHUNK_CHARS=80

# ── Firefox fetch ─────────────────────────────────────────────────────────────
# ALEXANDRIA_FETCH_TIMEOUT_SECONDS=10
# ALEXANDRIA_FETCH_CONNECT_TIMEOUT_SECONDS=5
# ALEXANDRIA_FETCH_CONCURRENCY=8
# ALEXANDRIA_FETCH_WAYBACK_FALLBACK=1   # on HTTP 404, send URL to archive.org for a snapshot
# ALEXANDRIA_FETCH_WAYBACK_EXTRA_BUDGET_SECONDS=15
# ALEXANDRIA_FETCH_WIKIPEDIA_RETRY_DELAY_SECONDS=2
# ALEXANDRIA_FETCH_WIKIPEDIA_MAX_RETRIES=2
# ALEXANDRIA_FETCH_USER_AGENT=Alexandria/0.2 (local research library)

# ── Images ────────────────────────────────────────────────────────────────────
# ALEXANDRIA_OCR_LANG=eng
# ALEXANDRIA_CLIP_MODEL=openai/clip-vit-base-patch32

# ── API ───────────────────────────────────────────────────────────────────────
# ALEXANDRIA_DEV=1   # dev API: CORS for :5173 + one-time Firefox/Zotero DB snapshots
#              # also re-queues all unfetchable Firefox URLs on Fetch & embed
# Per-source doc cap during dev ingestion (default 10 each):
# ALEXANDRIA_DEV_INGESTION_LIMIT_FIREFOX=10
# ALEXANDRIA_DEV_INGESTION_LIMIT_ZOTERO=10
# ALEXANDRIA_DEV_INGESTION_LIMIT_CALIBRE=10
# ALEXANDRIA_DEV_INGESTION_LIMIT_IMAGE=10
