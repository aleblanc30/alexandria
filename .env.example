# Copy to .env and uncomment any settings you want to override.
# Defaults live in pka/config.py — these examples mirror them.

# ── Source paths ──────────────────────────────────────────────────────────────
# PKA_ZOTERO_DB=~/Zotero/zotero.sqlite
# PKA_FIREFOX_DB=~/.mozilla/firefox
# PKA_BOOK_ARCHIVE=~/Documents/books
# PKA_IMAGES_DIR=~/Pictures/research

# ── Output paths ──────────────────────────────────────────────────────────────
# PKA_DATA_DIR=data

# ── Ollama (chat / vision only; text chunks embed via Chroma) ─────────────────
# PKA_OLLAMA_BASE_URL=http://localhost:11434
# PKA_CHAT_MODEL=minimax-m2.5:cloud
# PKA_VISION_MODEL=llava

# ── Chunking ──────────────────────────────────────────────────────────────────
# PKA_CHUNK_SENTENCES=5
# PKA_CHUNK_OVERLAP=1
# PKA_MIN_CHUNK_CHARS=80

# ── Firefox fetch ─────────────────────────────────────────────────────────────
# PKA_FETCH_TIMEOUT_SECONDS=10
# PKA_FETCH_CONNECT_TIMEOUT_SECONDS=5
# PKA_FETCH_CONCURRENCY=8

# ── Images ────────────────────────────────────────────────────────────────────
# PKA_OCR_LANG=eng
# PKA_CLIP_MODEL=openai/clip-vit-base-patch32

# ── API ───────────────────────────────────────────────────────────────────────
# PKA_DEV=1   # dev API: CORS for :5173 + one-time Firefox places snapshot
# PKA_DEV_INGESTION_LIMIT=100   # cap docs per source during dev ingestion
